<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notif_badge_large"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 Đang tập trung sâu"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#E64A19" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/notif_cycle_large"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phiên 1 / 4 trong vòng này"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/notif_title_large"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tập trung tự do"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="4dp" />

    <!-- Hero Central Countdown Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <Chronometer
                android:id="@+id/notif_chronometer_large"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="38sp"
                android:textStyle="bold"
                android:textColor="#E64A19"
                android:gravity="center"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/notif_timer_text_large"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="38sp"
                android:textStyle="bold"
                android:textColor="#E64A19"
                android:gravity="center"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/notif_status_large"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thời gian còn lại"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</LinearLayout>
